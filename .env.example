# Madad environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Runtime environment: development | production
ENVIRONMENT=development

# Database URL
# SQLite (local dev): sqlite:///./madad.db
# PostgreSQL (docker/prod): postgresql+psycopg2://madad:madad@db:5432/madad
DATABASE_URL=sqlite:///./madad.db

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this MUST be at least 32 bytes and kept secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=1440

# CORS allowed origins (comma-separated). Use * for local dev only.
CORS_ORIGINS=*

# Admin seed credentials used by scripts/seed.py
ADMIN_SEED_EMAIL=admin@madad.pk
ADMIN_SEED_PASSWORD=admin12345
